# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or production backend URLs to version control.
# =============================================================================

# Server-Side Backend URL (Used by Next.js rewrites to proxy API and upload requests)
# In production (e.g. Vercel), set this in your deployment settings so it stays hidden from client browsers.
BACKEND_API_URL=http://localhost:8080

# Optional: Public API URL (Leave empty to use Next.js same-origin proxy, hiding backend domain from users)
# NEXT_PUBLIC_API_URL=

# Frontend Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Contact Information
NEXT_PUBLIC_CONTACT_LOCATION=រាជធានីភ្នំពេញ, ប្រទេសកម្ពុជា
NEXT_PUBLIC_SUPPORT_EMAIL=support@serviceplatform.kh
NEXT_PUBLIC_SUPPORT_PHONE=+855 87 955 888

# Social Media Links
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com
NEXT_PUBLIC_TELEGRAM_URL=https://t.me
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com
